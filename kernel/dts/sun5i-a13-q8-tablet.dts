/dts-v1/;
#include "sun5i-a13.dtsi"
#include "sun5i-reference-design-tablet.dtsi"

/ {
	model = "Q8 A13 Tablet";
	compatible = "allwinner,q8-a13", "allwinner,sun5i-a13";

	panel: panel {
		compatible = "bananapi,s070wv20-ct16";
		power-supply = <&reg_vcc3v3>;
		enable-gpios = <&axp_gpio 0 GPIO_ACTIVE_HIGH>; /* AXP GPIO0 */
		backlight = <&backlight>;

		port {
			panel_input: endpoint {
				remote-endpoint = <&tcon0_out_lcd>;
			};
		};
	};
};

&be0 {
	status = "okay";
};

&tcon0 {
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_rgb666_pins>;
	status = "okay";
};

&tcon0_out {
	tcon0_out_lcd: endpoint@0 {
		reg = <0>;
		remote-endpoint = <&panel_input>;
	};
};
/*
 * Casper TAB-WB72 / INTREEO
 *
 * Physical Home button connected to Allwinner A13 LRADC.
 * Measured under original Android 4.0.4:
 *   pressed  = 0x1b (27)
 *   released = 0x3f (63)
 *
 * Vref = 3.0V * 2/3 = 2.0V
 * Key voltage = 27 * 2000000 / 63 = 857142 uV
 */
 &lradc {
        vref-supply = <&reg_ldo2>;
        status = "okay";

        /delete-node/ button-200;
        /delete-node/ button-400;

        button-857 {
                label = "Casper Physical Home";
                linux,code = <KEY_HOME>;
                channel = <0>;
                voltage = <857142>;
        };
};
/*
 * Casper TAB-WB72 / INTREEO LCD
 * Timings derived from original Android 4.0.4 FEX.
 *
 * Experimental display timing override.
 * Kernel #5 remains the fallback.
 */
&panel {
        compatible = "panel-dpi";

        panel-timing {
                clock-frequency = <33000000>;

                hactive = <800>;
                vactive = <480>;

                hfront-porch = <209>;
                hsync-len = <1>;
                hback-porch = <45>;

                vfront-porch = <22>;
                vsync-len = <1>;
                vback-porch = <22>;
        };
};

/* Casper TAB-WB72: parallel camera interface */
&pio {
    csi0_pins: csi0-pins {
        pins = "PE0", "PE1", "PE2", "PE3",
               "PE4", "PE5", "PE6", "PE7",
               "PE8", "PE9", "PE10", "PE11";
        function = "csi0";
    };
    csi_data_pins: csi-data-pins {
        pins = "PE0", "PE2", "PE3",
               "PE4", "PE5", "PE6", "PE7",
               "PE8", "PE9", "PE10", "PE11";
        function = "csi0";
    };


    csi_mclk_pin: csi-mclk-pin {
        pins = "PE1";
        function = "csi0";
    };
};
/ {
    casper-csi-mclk-test {
        compatible = "casper,csi-mclk-test";
        clocks = <&ccu CLK_CSI>;
        clock-names = "mclk";
        pinctrl-names = "default";
        pinctrl-0 = <&csi_mclk_pin>;
        status = "disabled";
    };
};

/* Casper GC0308 camera sensor */
&i2c2 {
    status = "okay";

    gc0308: camera@21 {
        compatible = "galaxycore,gc0308";
        reg = <0x21>;

        clocks = <&ccu CLK_CSI>;

        pinctrl-names = "default";
        pinctrl-0 = <&csi_mclk_pin>;

        vdd28-supply = <&reg_camera_vdd>;

        reset-gpios = <&axp_gpio 3 GPIO_ACTIVE_LOW>;
        powerdown-gpios = <&pio 6 4 GPIO_ACTIVE_HIGH>;

        port {
            gc0308_out: endpoint {
                remote-endpoint = <&csi0_in>;
                bus-width = <8>;
            };
        };
    };
};

/* Casper: Release PG3/PG4 for camera standby */
&uart1 {
    status = "disabled";
};
/* Casper camera power enable via AXP209 GPIO2 */
 / {
    reg_camera_vdd: regulator-camera-vdd {
        compatible = "regulator-fixed";
        regulator-name = "casper-camera-vdd";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;

        gpio = <&axp_gpio 2 GPIO_ACTIVE_HIGH>;
        enable-active-high;
        gpio-open-drain;
        startup-delay-us = <10000>;
    };
};
/* Casper TAB-WB72 - Allwinner A13 CSI0 */
&{/soc} {
    csi0: csi@1c09000 {
        compatible = "allwinner,sun5i-a13-csi0";
        reg = <0x01c09000 0x1000>;
        interrupts = <42>;

        clocks = <&ccu CLK_AHB_CSI>,
                 <&ccu CLK_DRAM_CSI>;
        clock-names = "bus", "ram";

        resets = <&ccu RST_CSI>;

        pinctrl-names = "default";
        pinctrl-0 = <&csi_data_pins>;

        status = "okay";

        port {
            csi0_in: endpoint {
                remote-endpoint = <&gc0308_out>;
                bus-width = <8>;
            };
        };
    };
};
