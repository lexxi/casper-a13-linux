<?xml version="1.0" encoding="UTF-8"?>
<!-- Casper QWERTZ: conservative 4-row variant of the working 5-row Casper layout.
     Only number row removed; original key widths and all other rows retained.
     Numbers 1..0 available through the existing mod2 (⇪) key.
     This file is independent of system keyboard.xml/base-fragment*.xml. -->
<keyboard>
<layout id="Casper QWERTZ">
    <row>
        <key width="850" obey-caps="true">
            <default display="q" />
            <shifted display="Q" />
            <mod2 display="1" action="xkeysym:1"/>
        </key>
        <key width="850" obey-caps="true">
            <default display="w" />
            <shifted display="W" />
            <mod2 display="2" action="xkeysym:2"/>
        </key>
        <key width="850" obey-caps="true">
            <default display="e" />
            <shifted display="E" />
            <mod2 display="3" action="xkeysym:3"/>
        </key>
        <key width="850" obey-caps="true">
            <default display="r" />
            <shifted display="R" />
            <mod2 display="4" action="xkeysym:4"/>
        </key>
        <key width="850" obey-caps="true">
            <default display="t" />
            <shifted display="T" />
            <mod2 display="5" action="xkeysym:5"/>
        </key>
        <key width="850" obey-caps="true">
            <default display="z" />
            <shifted display="Z" />
            <mod2 display="6" action="xkeysym:6"/>
        </key>
        <key width="850" obey-caps="true">
            <default display="u" />
            <shifted display="U" />
            <mod2 display="7" action="xkeysym:7"/>
        </key>
        <key width="850" obey-caps="true">
            <default display="i" />
            <shifted display="I" />
            <mod2 display="8" action="xkeysym:8"/>
        </key>
        <key width="850" obey-caps="true">
            <default display="o" />
            <shifted display="O" />
            <mod2 display="9" action="xkeysym:9"/>
        </key>
        <key width="850" obey-caps="true">
            <default display="p" />
            <shifted display="P" />
            <mod2 display="0" action="xkeysym:0"/>
        </key>
        <key width="850" obey-caps="true">
            <default display="ü" />
            <shifted display="Ü" />
        </key>
        <key width="1100">
            <default display="⇦" action="backspace"/>
        </key>
    </row>
    <row>
        <key width="850" obey-caps="true">
            <default display="a" />
            <shifted display="A" />
        </key>
        <key width="850" obey-caps="true">
            <default display="s" />
            <shifted display="S" />
        </key>
        <key width="850" obey-caps="true">
            <default display="d" />
            <shifted display="D" />
        </key>
        <key width="850" obey-caps="true">
            <default display="f" />
            <shifted display="F" />
        </key>
        <key width="850" obey-caps="true">
            <default display="g" />
            <shifted display="G" />
        </key>
        <key width="850" obey-caps="true">
            <default display="h" />
            <shifted display="H" />
        </key>
        <key width="850" obey-caps="true">
            <default display="j" />
            <shifted display="J" />
        </key>
        <key width="850" obey-caps="true">
            <default display="k" />
            <shifted display="K" />
        </key>
        <key width="850" obey-caps="true">
            <default display="l" />
            <shifted display="L" />
        </key>
        <key width="850" obey-caps="true">
            <default display="ö" />
            <shifted display="Ö" />
        </key>
        <key width="850" obey-caps="true">
            <default display="ä" />
            <shifted display="Ä" />
        </key>
        <key width="1100">
            <default display="⏎" action="return"/>
        </key>
    </row>
    <row>
        <key width="1100">
            <default display="⇧" action="modifier:shift" />
            <caps display="⬆" action="modifier:shift" />
        </key>
        <key>
            <default display="⇪" action="modifier:mod2"/>
        </key>
        <key width="850" obey-caps="true">
            <default display="y" />
            <shifted display="Y" />
        </key>
        <key width="850" obey-caps="true">
            <default display="x" />
            <shifted display="X" />
        </key>
        <key width="850" obey-caps="true">
            <default display="c" />
            <shifted display="C" />
        </key>
        <key width="850" obey-caps="true">
            <default display="v" />
            <shifted display="V" />
        </key>
        <key width="850" obey-caps="true">
            <default display="b" />
            <shifted display="B" />
        </key>
        <key width="850" obey-caps="true">
            <default display="n" />
            <shifted display="N" />
        </key>
        <key width="850" obey-caps="true">
            <default display="m" />
            <shifted display="M" />
        </key>
        <key width="1800">
            <default display=" " action="space"/>
        </key>
    </row>
    <row>
        <key>
            <default display="-" action="xkeysym:minus"/>
        </key>
        <key>
            <default display="_" action="xkeysym:underscore"/>
        </key>
        <key>
            <default display="." action="xkeysym:period"/>
        </key>
        <key>
            <default display="/" action="xkeysym:slash"/>
        </key>
        <key>
            <default display="#" action="xkeysym:numbersign"/>
        </key>
        <key>
            <default display="\" action="xkeysym:backslash"/>
        </key>
        <key>
            <default display="," action="xkeysym:comma"/>
        </key>
    </row>
</layout>
</keyboard>
